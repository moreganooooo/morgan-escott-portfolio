---
import { Icon } from 'astro-icon/components';

interface Project {
  title: string;
  description: string;
  images?: string[];
  roles?: string[];
  tech: string[];
  platforms: string[];
  link: string;
  category: string;
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const images = project.images ?? [];
const isSlider = images.length > 1;
---

<a class:list={['work-card', { featured: images.length > 0 }]} href={project.link}
   target={project.link.startsWith('http') ? '_blank' : undefined} rel={project.link.startsWith('http') ? 'noopener' : undefined}
   data-roles={(project.roles ?? ['all']).join(',')}>
  {images.length > 0 && <div class:list={['cover', { 'image-slider': isSlider }]}>
    {images.map((src, index) => <img src={src} loading="lazy" alt="" class={index ? 'opacity-0' : 'opacity-100'} />)}
    {project.platforms?.map(platform => <Icon name={`mdi:${platform}`} class="platform-icon" />)}
  </div>}
  <div class="card-copy">
    <p class="kicker">{project.category}</p>
    <h3>{project.title}</h3><p>{project.description}</p>
    <ul class="tags">{project.tech.map(tag => <li>{tag}</li>)}</ul>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </div>
</a>

<script>
  function initSliders() {
    const sliders = document.querySelectorAll('.image-slider');
    
    sliders.forEach(slider => {
      const images = slider.querySelectorAll('img');
      if (images.length <= 1 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let currentIndex = 0;
      setInterval(() => {
        // Hide current
        images[currentIndex].classList.remove('opacity-100', 'z-0');
        images[currentIndex].classList.add('opacity-0', 'z-[-1]');
        
        // Move to next
        currentIndex = (currentIndex + 1) % images.length;
        
        // Show next
        images[currentIndex].classList.remove('opacity-0', 'z-[-1]');
        images[currentIndex].classList.add('opacity-100', 'z-0');
      }, 3500);
    });
  }

  initSliders();
  document.addEventListener('astro:after-swap', initSliders);
</script>
