---
import ProjectCard from './project-card.astro';
import data from '../data/projects.json';
const slugFor = (link: string) => link;
---
<section class="work band" id="projects">
  <div class="wrap">
    <div class="work-heading">
      <div>
        <p class="kicker">Selected projects &amp; writing</p>
        <h2>Work with a little<br /><em>something behind it.</em></h2>
      </div>
      <label class="role-picker" hidden>Highlight by role
        <select id="role-focus">
          <option value="general">All roles</option>
          <option value="sales-ops">Sales Operations &amp; CRM</option>
          <option value="marketing">Marketing &amp; Copywriting</option>
          <option value="creative">Branding &amp; Creative</option>
          <option value="admin">Executive &amp; Admin Support</option>
        </select>
      </label>
    </div>
    <p class="work-intro">A selection of campaigns, content systems, and creative projects. Each started with a question about the audience and what they needed next.</p>
    <div class="work-list">{data.items.map(project => <ProjectCard project={{...project, link: slugFor(project.link)}} />)}</div>
  </div>
</section>

<script>
  import '../scripts/roleSwitcher.js';
</script>
