<section id="intro" class="intro" aria-label="Introduction">
  <video muted playsinline preload="none" poster="/neon/ink-first-frame.webp" data-src="/neon/ink.mp4" aria-hidden="true"></video>
  <div class="ink-texture" aria-hidden="true"></div>
  <h1>Let’s<br /><span class="build-word">build</span><br />something<br /><span class="intro-last-line"><a class="beautiful-word" href="/home/">beautiful.</a><a class="enter" href="/home/" aria-label="Enter the portfolio"><span aria-hidden="true">→</span></a></span></h1>
  <div class="intro-controls">
    <a class="skip-intro" href="/home/">Skip intro</a>
    <button type="button" hidden class="motion-control">Pause intro</button>
  </div>
</section>
<script>
  const intro = document.querySelector<HTMLElement>('.intro')!;
  const video = intro.querySelector('video')!;
  const control = intro.querySelector('button')!;
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const connection = 'connection' in navigator ? (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection : undefined;
  let frame = 0;
  let stallTimer = 0;
  let pausedByVisitor = false;
  let settled = false;

  // Smoothstep gives every fade a gentle start and finish on the film's own clock.
  function fade(time: number, start: number, end: number) {
    const x = Math.max(0, Math.min(1, (time - start) / (end - start)));
    return x * x * (3 - 2 * x);
  }
  function draw() {
    const time = video.currentTime;
    intro.style.setProperty('--title-alpha', String(fade(time, 2, 6.2)));
    intro.style.setProperty('--film-alpha', String(1 - fade(time, 18.5, 23.3)));
    intro.style.setProperty('--texture-alpha', String(.3 * (fade(time, 18.5, 21.7) - fade(time, 21.7, 24))));
    intro.style.setProperty('--marker-alpha', String(fade(time, 23, 24.45)));
    intro.style.setProperty('--arrow-alpha', String(fade(time, 23.55, 25)));
    intro.classList.toggle('title-visible', time > 2);
    intro.classList.toggle('arrow-visible', time > 23.55);
  }
  function tick() {
    draw();
    if ('requestVideoFrameCallback' in HTMLVideoElement.prototype) {
      (video as HTMLVideoElement & { requestVideoFrameCallback: (callback: () => void) => number }).requestVideoFrameCallback(() => tick());
    } else {
      frame = requestAnimationFrame(tick);
    }
  }
  function stopClock() {
    cancelAnimationFrame(frame);
    clearTimeout(stallTimer);
  }
  function finish() {
    settled = true;
    stopClock();
    intro.classList.add('intro-settled');
    video.pause();
    control.hidden = true;
  }
  function watchForPlayback() {
    clearTimeout(stallTimer);
    if (!document.hidden && !pausedByVisitor && !settled) {
      stallTimer = window.setTimeout(finish, 8000);
    }
  }
  function syncPlayback() {
    if (settled) return;
    if (preference.matches || connection?.saveData || connection?.effectiveType === 'slow-2g' || connection?.effectiveType === '2g') return finish();
    if (document.hidden || pausedByVisitor) {
      stopClock();
      video.pause();
      return;
    }
    if (!video.hasAttribute('src')) video.src = video.dataset.src!;
    watchForPlayback();
    video.play().catch(error => {
      if (error.name !== 'AbortError') finish();
    });
  }
  video.addEventListener('playing', () => {
    stopClock();
    if (settled || video.paused) return;
    control.hidden = false;
    tick();
  });
  video.addEventListener('waiting', () => { stopClock(); watchForPlayback(); });
  video.addEventListener('pause', stopClock);
  video.addEventListener('loadedmetadata', draw);
  video.addEventListener('seeked', draw);
  video.addEventListener('ended', finish);
  video.addEventListener('error', finish);
  control.addEventListener('click', () => {
    pausedByVisitor = !pausedByVisitor;
    control.textContent = pausedByVisitor ? 'Play intro' : 'Pause intro';
    syncPlayback();
  });
  document.addEventListener('visibilitychange', syncPlayback);
  preference.addEventListener('change', syncPlayback);
  syncPlayback();
</script>
