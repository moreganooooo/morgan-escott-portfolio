---
import Starburst from '../assets/starburst.svg';
import home from '../data/home.json';
---
<footer id="contact" class="contact band">
  <div class="wrap">
    <figure class="quote">
      <Starburst class="quote-star" aria-hidden="true" />
      <blockquote>“She was on point with our brand focus of always trying to help new prospects first and had tremendous results in driving engagement with target customers.”</blockquote>
      <figcaption>Ray Mina · Former Head of Sales, Element 8</figcaption>
    </figure>
    <div class="contact-row"><div>
      <p class="kicker">Have a good project in mind?</p>
      <h2>Let’s talk<span>.</span></h2>
    </div>
      <div class="inline-links">{home.socials.map(s => <a href={s.url} target={s.url.startsWith('http') ? '_blank' : undefined} rel={s.url.startsWith('http') ? 'noopener' : undefined}>{s.name} ↗</a>)}</div>
    </div>
    <div class="credits"><span>{home.name} · Buffalo, NY area</span><a href="#home">Back to top ↑</a></div>
  </div>
</footer>
