---
import Layout from '../layouts/Layout.astro';
import Opening from '../components/opening.astro';
import profile from '../data/home.json';
---
<Layout title={profile.webpageTitle} landing>
  <script is:inline>
    // Preserve bookmarked sections from the original single-page portfolio.
    if (['#home', '#about', '#projects', '#career', '#tech', '#contact'].includes(location.hash)) {
      location.replace('/home/' + location.search + location.hash);
    }
  </script>
  <Opening />
</Layout>
